{
  "openapi": "3.0.3",
  "info": {
    "title": "Hotel Hall Booking Management System API",
    "version": "1.0.0",
    "description": "Documented per docs/03-standards/api-standards.md §16. One `paths`/`components.schemas` section grows per module as each is implemented — this file currently covers Authentication & Account Management (Module 1) and Hotel Management (Module 3)."
  },
  "servers": [{ "url": "/api/v1", "description": "Version 1 (api-standards.md §3)" }],
  "tags": [
    {
      "name": "Authentication",
      "description": "Identity, login, account lifecycle (Module 1). Endpoints per docs/05-technical-design/modules/01-authentication-and-account-management/technical-design.md §10."
    },
    {
      "name": "Hotels",
      "description": "The Hotel business entity and its onboarding lifecycle (Module 3). Endpoints per docs/05-technical-design/modules/03-hotel-management/technical-design.md §11. No approve/reject/suspend/deactivate endpoint exists here — that action belongs to Administration & Platform Management's own future API surface (BR-HOTEL-14)."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token, per api-standards.md §12: `Authorization: Bearer <JWT>`."
      }
    },
    "schemas": {
      "SuccessEnvelope": {
        "type": "object",
        "description": "api-standards.md §7 — every successful response.",
        "properties": {
          "status": { "type": "string", "enum": ["success"] },
          "message": { "type": "string" },
          "data": {},
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["status", "message", "data", "timestamp"]
      },
      "ErrorEnvelope": {
        "type": "object",
        "description": "api-standards.md §8 — every non-2xx response.",
        "properties": {
          "status": { "type": "string", "enum": ["error"] },
          "error": { "type": "string", "example": "VALIDATION_ERROR" },
          "message": { "type": "string" },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "field": { "type": "string" }, "message": { "type": "string" } }
            }
          },
          "timestamp": { "type": "string", "format": "date-time" },
          "requestId": { "type": "string", "format": "uuid" }
        },
        "required": ["status", "error", "message", "timestamp", "requestId"]
      },
      "PublicUser": {
        "type": "object",
        "description": "A User Account, never including passwordHash (data-architecture.md §13, Restricted).",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "mobileNumber": { "type": "string", "example": "+15551234567" },
          "accountType": {
            "type": "string",
            "enum": ["CUSTOMER", "HOTEL_MANAGER", "STAFF", "PLATFORM_ADMINISTRATOR"]
          },
          "isVerified": { "type": "boolean" },
          "isActive": { "type": "boolean" }
        }
      },
      "PublicHotel": {
        "type": "object",
        "description": "The Hotel entity (Technical Design §4). profileData shape is deliberately unspecified — Business Specification Pending Business Decision #7.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "registeredByUserId": { "type": "string", "format": "uuid" },
          "status": {
            "type": "string",
            "enum": ["REGISTERED", "PROFILE_COMPLETE", "UNDER_REVIEW", "APPROVED_ACTIVE", "REJECTED", "WITHDRAWN", "SUSPENDED", "DEACTIVATED", "RESTRICTED_UNDER_REVIEW"]
          },
          "profileData": { "type": "object", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "PublicHotelApplication": {
        "type": "object",
        "description": "One review cycle (Technical Design §4) — a resubmission creates a new record, never overwrites a decided one.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "hotelId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["OPEN", "APPROVED", "REJECTED", "WITHDRAWN"] },
          "decidedByUserId": { "type": "string", "format": "uuid", "nullable": true },
          "decidedAt": { "type": "string", "format": "date-time", "nullable": true },
          "submittedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new Customer or Hotel account",
        "description": "Creates a new User Account (BR-AUTH-02, BR-AUTH-03, C2, H1). Self-registration only ever creates a Customer or Hotel Manager account — Staff and Platform Administrator accounts are created by other modules (Business Specification §3).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mobileNumber", "password", "accountType"],
                "properties": {
                  "mobileNumber": { "type": "string", "example": "+15551234567" },
                  "password": { "type": "string", "format": "password", "minLength": 8 },
                  "accountType": { "type": "string", "enum": ["CUSTOMER", "HOTEL_MANAGER"] }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created (unverified).",
            "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/PublicUser" } } }] } } }
          },
          "400": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "422": { "description": "The mobile number is already registered (BR-AUTH-02).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Authenticate and issue tokens",
        "description": "C4, H7, A1 (Technical Design §7.1). Blocked for a deactivated account (BR-AUTH-06) with a message distinct from invalid credentials.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mobileNumber", "password"],
                "properties": {
                  "mobileNumber": { "type": "string", "example": "+15551234567" },
                  "password": { "type": "string", "format": "password" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "accessToken": { "type": "string" },
                            "refreshToken": { "type": "string" },
                            "user": { "$ref": "#/components/schemas/PublicUser" }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "description": "Invalid credentials, or the account is inactive (BR-AUTH-06, BR-AUTH-09 — never reveals which).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "End the current session",
        "description": "C5, A2, BR-AUTH-13 (Technical Design §7.2). Ends the Session identified by the access token's own `sid` claim — no request body needed.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Logged out. No further action succeeds on this session without logging in again." },
          "401": { "description": "Missing, invalid, or expired access token.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Exchange a refresh token for a new access token",
        "description": "Technical Design §7.3. The refresh token is never accepted anywhere an access token is expected (api-standards.md §12); rotated on every use (single-use).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["refreshToken"], "properties": { "refreshToken": { "type": "string" } } }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New access + refresh token pair.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    { "properties": { "data": { "type": "object", "properties": { "accessToken": { "type": "string" }, "refreshToken": { "type": "string" } } } } }
                  ]
                }
              }
            }
          },
          "401": { "description": "Invalid, expired, or already-rotated refresh token (BR-AUTH-11).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Retrieve the authenticated identity's own account summary",
        "description": "C8 (Technical Design §10).",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The caller's own account.",
            "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/PublicUser" } } }] } } }
          },
          "401": { "description": "Missing, invalid, or expired access token.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/auth/verifications": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Request a mobile-number verification code",
        "description": "C3, BR-AUTH-02. Delivered via SMS (Twilio, ADR-0005) behind the SmsProvider abstraction — MockSmsProvider in any environment without Twilio credentials configured.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Verification code sent.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessEnvelope" } } } },
          "401": { "description": "Missing, invalid, or expired access token.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "409": { "description": "An active (unexpired) verification code was already sent.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "422": { "description": "The account is already verified.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/auth/verifications/confirm": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Confirm a mobile-number verification code",
        "description": "C3, BR-AUTH-02. Activates the User Account on success.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["code"], "properties": { "code": { "type": "string", "pattern": "^[0-9]{6}$", "example": "482913" } } } } }
        },
        "responses": {
          "200": {
            "description": "Account verified.",
            "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/PublicUser" } } }] } } }
          },
          "400": { "description": "Malformed code.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "401": { "description": "Missing, invalid, or expired access token.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "422": { "description": "Invalid or expired verification request.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/auth/password-resets": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Request a password reset",
        "description": "C6, BR-AUTH-09. Never reveals whether the mobile number is registered — the response is identical either way.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["mobileNumber"], "properties": { "mobileNumber": { "type": "string", "example": "+15551234567" } } } } }
        },
        "responses": {
          "200": { "description": "Generic acknowledgement — identical whether or not the account exists.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessEnvelope" } } } },
          "400": { "description": "Malformed mobile number.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      },
      "patch": {
        "tags": ["Authentication"],
        "summary": "Confirm a password reset",
        "description": "C6, BR-AUTH-09. Takes `mobileNumber` + `code` rather than a request id — Technical Design v1.5 correction: the POST above cannot return an id without violating its own anti-enumeration requirement.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mobileNumber", "code", "newPassword"],
                "properties": {
                  "mobileNumber": { "type": "string", "example": "+15551234567" },
                  "code": { "type": "string", "pattern": "^[0-9]{6}$", "example": "482913" },
                  "newPassword": { "type": "string", "format": "password", "minLength": 8 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password reset.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessEnvelope" } } } },
          "400": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "422": { "description": "Invalid or expired password reset request.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/auth/password": {
      "patch": {
        "tags": ["Authentication"],
        "summary": "Change password while authenticated",
        "description": "C7, A3, BR-AUTH-08. Ends every existing Session (refresh tokens) as a security default — the caller's own current access token remains valid until its own natural expiry (Technical Design §9; no access-token blocklist).",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["currentPassword", "newPassword"],
                "properties": {
                  "currentPassword": { "type": "string", "format": "password" },
                  "newPassword": { "type": "string", "format": "password", "minLength": 8 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password changed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessEnvelope" } } } },
          "400": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "401": { "description": "Missing, invalid, or expired access token.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "422": { "description": "The current password is incorrect.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/hotels": {
      "post": {
        "tags": ["Hotels"],
        "summary": "Register a new Hotel",
        "description": "HM1. Any authenticated Hotel Manager identity may register a Hotel (Technical Design §11).",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "profileData": { "type": "object" } } }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Hotel created (REGISTERED).",
            "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/PublicHotel" } } }] } } }
          },
          "400": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "401": { "description": "Missing, invalid, or expired access token.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      },
      "get": {
        "tags": ["Hotels"],
        "summary": "List Hotels, filterable by status",
        "description": "Platform-Administrator-only query interface — the source the Hotel approval queue reads from (Technical Design §11). Paginated per api-standards.md §10.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["REGISTERED", "PROFILE_COMPLETE", "UNDER_REVIEW", "APPROVED_ACTIVE", "REJECTED", "WITHDRAWN", "SUSPENDED", "DEACTIVATED", "RESTRICTED_UNDER_REVIEW"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "A page of Hotels.",
            "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/PublicHotel" } } } }] } } }
          },
          "400": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "403": { "description": "Not a Platform Administrator.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/hotels/{id}": {
      "get": {
        "tags": ["Hotels"],
        "summary": "Retrieve a Hotel's own profile and current status",
        "description": "Supports HM2–HM15. Own-Hotel only for a Hotel Manager, or any Hotel for a Platform Administrator (Technical Design §11).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": {
            "description": "Hotel retrieved.",
            "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/PublicHotel" } } }] } } }
          },
          "404": { "description": "Not found, or belongs to a different Hotel Manager (api-standards.md §9, tenant isolation).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      },
      "patch": {
        "tags": ["Hotels"],
        "summary": "Update Hotel profile fields",
        "description": "HM2 (initial completion, REGISTERED), HM7 (edit after rejection), HM12/HM13 (ordinary/critical change while Approved/Active) — Technical Design §8, §11. The Profile Component routes based on the Hotel's current status.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object" } } }
        },
        "responses": {
          "200": {
            "description": "Applied immediately, or accepted pending Platform Administrator review (critical changes, BR-HOTEL-12).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessEnvelope" } } }
          },
          "400": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "404": { "description": "Not found, or belongs to a different Hotel Manager.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "422": { "description": "The Hotel's current status does not permit profile changes.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/hotels/{id}/applications": {
      "post": {
        "tags": ["Hotels"],
        "summary": "Submit or resubmit an application for review",
        "description": "HM3 (from PROFILE_COMPLETE) or HM7–HM8 (resubmission from REJECTED, BDR-010) — Technical Design §7, §11. Modeled as a non-idempotent sub-resource action per api-standards.md §5.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "201": {
            "description": "Application submitted; Hotel now UNDER_REVIEW.",
            "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/PublicHotelApplication" } } }] } } }
          },
          "404": { "description": "Not found, or belongs to a different Hotel Manager.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "409": { "description": "This Hotel already has an application under review.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "422": { "description": "The Hotel's profile is not complete, or its status does not permit submission (BR-HOTEL-02, BR-HOTEL-03).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/hotels/{id}/applications/{applicationId}/withdrawal": {
      "post": {
        "tags": ["Hotels"],
        "summary": "Withdraw a pending application",
        "description": "HM9, BR-HOTEL-08 — Technical Design §11.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "applicationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Application withdrawn; Hotel now WITHDRAWN.",
            "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/SuccessEnvelope" }, { "properties": { "data": { "$ref": "#/components/schemas/PublicHotelApplication" } } }] } } }
          },
          "404": { "description": "Not found, or belongs to a different Hotel Manager.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "409": { "description": "This Hotel has no open application to withdraw.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    }
  }
}
