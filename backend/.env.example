# Backend-local environment template. Copy to `.env` for local development.
# Full reference: repository-root .env.example
# (docs/03-standards/naming-conventions.md §10)

DATABASE_URL=
NODE_ENV=
PORT=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Development defaults if unset (15 / 7) — Session Validity Duration is
# Business Specification Pending Business Decision #3, not yet settled;
# see docs/05-technical-design/modules/01-authentication-and-account-management/technical-design.md §9.
ACCESS_TOKEN_TTL_MINUTES=
REFRESH_TOKEN_TTL_DAYS=

# Argon2id parameters — OWASP baseline defaults if unset (19456 / 2 / 1).
# See technical-design.md §11.
ARGON2_MEMORY_COST_KIB=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=

# Development defaults if unset (10 / 30) — code format/window is Business
# Specification Pending Business Decision #2, not yet settled.
VERIFICATION_CODE_TTL_MINUTES=
PASSWORD_RESET_CODE_TTL_MINUTES=

# Optional dev/test convenience — if set (e.g. 123456), every account-
# verification (C3) code becomes this fixed value instead of a random one,
# so manual testing doesn't require pulling the code out of the mock SMS
# provider by hand. Deliberately does NOT apply to password-reset codes
# (that token is stored in a globally-unique DB column; a fixed value would
# collide after the first use). Only takes effect while TWILIO_* below is
# unset; has no effect at all once real Twilio credentials are configured.
# Leave blank in any shared/production environment.
DEV_FIXED_VERIFICATION_CODE=

FCM_SERVER_KEY=

# SMS delivery (Twilio) — approved via ADR-0005, scoped to Authentication &
# Account Management's identity-verification and password-reset flows.
# Optional: if any of the three is unset, the app falls back to
# MockSmsProvider automatically (shared/providers/smsProvider.js) rather
# than failing to start. Never fill these with a placeholder value — leave
# them blank to use the mock provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Media storage (Supabase) — approved via ADR-0006, scoped to Hotel
# Management's Hotel Logo/Photo upload (BDR-015, Technical Design §8a).
# Optional: if either is unset, the app falls back to MockStorageProvider
# automatically (shared/providers/storageProvider.js) rather than failing
# to start. SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — never
# send it to any client app; it is read only by this backend process. Never
# fill these with a placeholder value — leave them blank to use the mock
# provider. SUPABASE_STORAGE_BUCKET defaults to `hotel-media` if unset.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
