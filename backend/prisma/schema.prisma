generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A login identity — one per Customer, Hotel Manager, Staff Member, or
/// Platform Administrator account. Never holds business-profile data owned
/// by another module (Technical Design §3.2, §5).
model User {
  id                                       String                             @id @default(uuid()) @db.Uuid
  /// The only contact channel this module establishes (BDR-009, BR-AUTH-02).
  mobileNumber                             String                             @unique @map("mobile_number")
  passwordHash                             String                             @map("password_hash")
  /// Doubles as the source of the role claim (BR-AUTH-14) — production only,
  /// not permission policy (owned by Security & Access Control, Module 14).
  accountType                              UserAccountType                    @map("account_type")
  isVerified                               Boolean                            @default(false) @map("is_verified")
  isActive                                 Boolean                            @default(true) @map("is_active")
  createdAt                                DateTime                           @default(now()) @map("created_at")
  updatedAt                                DateTime                           @updatedAt @map("updated_at")
  deletedAt                                DateTime?                          @map("deleted_at")
  decidedCriticalInformationChangeRequests CriticalInformationChangeRequest[]
  decidedHotelApplications                 HotelApplication[]
  registeredHotels                         Hotel[]
  passwordResetRequests                    PasswordResetRequest[]
  sessions                                 Session[]
  verificationRequests                     VerificationRequest[]
  customerProfile                          CustomerProfile?

  @@map("users")
}

/// Customer-owned business profile, deliberately separate from Authentication.
/// Profile fields remain empty/flexible until the pending M02 business decisions
/// approve an explicit allowlist and completion policy.
model CustomerProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  profileData Json      @default("{}") @map("profile_data")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

/// One authenticated session (Technical Design §5, §9). Session and Refresh
/// Token are modeled as a single 1:1 table, per database-standards.md §10
/// ("One-to-One... used only when splitting a table for a genuine lifecycle
/// or access-control reason — never just to organize columns for tidiness").
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// Never the raw refresh token — hashed at rest, same as a password
  /// (data-architecture.md §13, Restricted classification).
  refreshTokenHash String    @unique @map("refresh_token_hash")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user_id")
  @@map("sessions")
}

/// A pending or resolved mobile-number verification attempt (BR-AUTH-02,
/// Technical Design §13.3). Scaffolded now (Technical Design §5); the
/// Verification Component's endpoints (WBS-10) are a later increment.
model VerificationRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at")
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_verification_requests_user_id")
  @@map("verification_requests")
}

/// A pending or resolved password-reset attempt (BR-AUTH-09). Scaffolded now
/// (Technical Design §5); the Password Reset endpoints (WBS-11b) are a later
/// increment.
model PasswordResetRequest {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Never the raw reset token — hashed at rest (data-architecture.md §13).
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_requests_user_id")
  @@map("password_reset_requests")
}

/// The Hotel business entity and tenant (Technical Design §4) — the
/// aggregate root every other component in this module operates on. Never
/// holds Hotel Manager identity/credentials (Module 1's User, §3.2).
model Hotel {
  id                     String                             @id @default(uuid()) @db.Uuid
  /// The Hotel Manager who registered this Hotel (HM1). Technical Design
  /// §4.1 notes a Hotel may be referenced by more than one Hotel Manager
  /// account per Project-Glossary.md ("at least one"), but no approved
  /// journey exercises more than one — a single registering-owner reference
  /// is the simplest design that satisfies every approved journey
  /// (architecture-principles.md §2, Simplicity before complexity). A
  /// many-to-many assignment table is a additive change if ever required.
  registeredByUserId     String                             @map("registered_by_user_id") @db.Uuid
  /// The Hotel Lifecycle (Technical Design §6.1) — the single source of
  /// truth for what a Hotel may currently do. Mutated only through the
  /// Lifecycle (State) Component (lifecycle.service.js), never directly.
  status                 HotelStatus                        @default(REGISTERED)
  /// Profile content is deliberately unspecified — Business Specification
  /// Pending Business Decision #7 (Required Business-Profile Content).
  /// Held as a flexible field until that decision resolves; Technical
  /// Design §4 explicitly avoids inventing named profile columns ahead of
  /// an approved decision.
  profileData            Json?                              @map("profile_data")
  createdAt              DateTime                           @default(now()) @map("created_at")
  updatedAt              DateTime                           @updatedAt @map("updated_at")
  deletedAt              DateTime?                          @map("deleted_at")
  criticalChangeRequests CriticalInformationChangeRequest[]
  halls                  Hall[]
  applications           HotelApplication[]
  media                  HotelMedia[]
  registeredBy           User                               @relation(fields: [registeredByUserId], references: [id])

  @@index([status], map: "idx_hotels_status")
  @@map("hotels")
}

/// A single uploaded Hotel Logo or Photo (BDR-015, ADR-0006, Technical
/// Design §4, §8a). Stores only a reference to the file in Supabase
/// Storage — never the binary itself (database-standards.md). At most one
/// LOGO record per Hotel at a time is a business-level constraint enforced
/// by the Media Component, not a database constraint (Technical Design §5)
/// — PHOTO has no such limit.
model HotelMedia {
  id           String    @id @default(uuid()) @db.Uuid
  hotelId      String    @map("hotel_id") @db.Uuid
  type         MediaType
  /// The Supabase Storage object path (bucket-relative) — e.g.
  /// `hotels/{hotelId}/logo/{fileId}.jpg` — the permanent database
  /// reference. Never a temporary signed URL (Technical Design §8a); a
  /// stable public URL is derived from this path at read time.
  storagePath  String    @map("storage_path")
  displayOrder Int?      @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  hotel        Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId], map: "idx_hotel_media_hotel_id")
  @@map("hotel_media")
}

/// One review cycle (Technical Design §4) — the initial submission, or a
/// new record for each resubmission after rejection (BR-HOTEL-07).
/// Historical, append-only: never overwritten, never reopened once decided
/// (Technical Design §5, §15.2).
model HotelApplication {
  id              String                 @id @default(uuid()) @db.Uuid
  hotelId         String                 @map("hotel_id") @db.Uuid
  status          HotelApplicationStatus @default(OPEN)
  /// The Platform Administrator who approved/rejected this Application
  /// (Administration & Platform Management, Module 13 — referenced, never
  /// owned, BR-HOTEL-14).
  decidedByUserId String?                @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?              @map("decided_at")
  decisionReason  String?                @map("decision_reason")
  submittedAt     DateTime               @default(now()) @map("submitted_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  decidedBy       User?                  @relation(fields: [decidedByUserId], references: [id])
  hotel           Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId], map: "idx_hotel_applications_hotel_id")
  @@map("hotel_applications")
}

/// A critical-information change awaiting Platform Administrator review
/// (BR-HOTEL-12), independent of the Hotel's own status throughout its
/// lifecycle (Technical Design §6, §15.3 — the deliberate design response
/// to Pending Business Decision #6).
model CriticalInformationChangeRequest {
  id              String               @id @default(uuid()) @db.Uuid
  hotelId         String               @map("hotel_id") @db.Uuid
  status          CriticalChangeStatus @default(PENDING)
  /// The proposed change, shape TBD alongside Hotel.profileData (Pending
  /// Business Decision #7).
  proposedData    Json                 @map("proposed_data")
  decidedByUserId String?              @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?            @map("decided_at")
  submittedAt     DateTime             @default(now()) @map("submitted_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  decidedBy       User?                @relation(fields: [decidedByUserId], references: [id])
  hotel           Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId], map: "idx_critical_information_change_requests_hotel_id")
  @@map("critical_information_change_requests")
}

/// The Hall business entity — the Platform's bookable inventory (Technical
/// Design §4). Deliberately has no status/visibility column: a Hall's
/// visibility is computed live from its owning Hotel's operational-
/// eligibility status (Technical Design §6), never persisted or
/// synchronized here, so there is nothing to keep in sync or invalidate.
model Hall {
  id          String      @id @default(uuid()) @db.Uuid
  hotelId     String      @map("hotel_id") @db.Uuid
  /// Profile content (including Amenities, BR-HALL-06) is deliberately
  /// unspecified — Business Specification Pending Business Decision #2
  /// (Required Hall Information). Held as a flexible field until that
  /// decision resolves, mirroring Hotel's own profileData design exactly
  /// (Technical Design §4, §8).
  profileData Json?       @map("profile_data")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")
  hotel       Hotel       @relation(fields: [hotelId], references: [id])
  media       HallMedia[]

  @@index([hotelId], map: "idx_halls_hotel_id")
  @@map("halls")
}

/// A single uploaded Hall Photo (BDR-016, ADR-0007). Stores only a
/// bucket-relative Supabase Storage reference, never the binary itself.
/// Hall media supports Photos only; no Hall Logo business field exists.
model HallMedia {
  id           String    @id @default(uuid()) @db.Uuid
  hallId       String    @map("hall_id") @db.Uuid
  type         MediaType
  storagePath  String    @map("storage_path")
  displayOrder Int?      @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  hall         Hall      @relation(fields: [hallId], references: [id], onDelete: Cascade)

  @@index([hallId], map: "idx_hall_media_hall_id")
  @@map("hall_media")
}

enum UserAccountType {
  CUSTOMER
  HOTEL_MANAGER
  STAFF
  PLATFORM_ADMINISTRATOR

  @@map("user_account_type")
}

enum HotelStatus {
  REGISTERED
  PROFILE_COMPLETE
  UNDER_REVIEW
  APPROVED_ACTIVE
  REJECTED
  WITHDRAWN
  SUSPENDED
  DEACTIVATED
  RESTRICTED_UNDER_REVIEW

  @@map("hotel_status")
}

enum MediaType {
  LOGO
  PHOTO

  @@map("media_type")
}

enum HotelApplicationStatus {
  OPEN
  APPROVED
  REJECTED
  WITHDRAWN

  @@map("hotel_application_status")
}

enum CriticalChangeStatus {
  PENDING
  APPLIED
  REJECTED

  @@map("critical_change_status")
}
