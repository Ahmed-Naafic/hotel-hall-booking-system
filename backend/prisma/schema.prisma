generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A login identity — one per Customer, Hotel Manager, Staff Member, or
/// Platform Administrator account. Never holds business-profile data owned
/// by another module (Technical Design §3.2, §5).
model User {
  id                                       String                             @id @default(uuid()) @db.Uuid
  /// The only contact channel this module establishes (BDR-009, BR-AUTH-02).
  mobileNumber                             String                             @unique @map("mobile_number")
  passwordHash                             String                             @map("password_hash")
  /// Doubles as the source of the role claim (BR-AUTH-14) — production only,
  /// not permission policy (owned by Security & Access Control, Module 14).
  accountType                              UserAccountType                    @map("account_type")
  isVerified                               Boolean                            @default(false) @map("is_verified")
  isActive                                 Boolean                            @default(true) @map("is_active")
  createdAt                                DateTime                           @default(now()) @map("created_at")
  updatedAt                                DateTime                           @updatedAt @map("updated_at")
  deletedAt                                DateTime?                          @map("deleted_at")
  decidedCriticalInformationChangeRequests CriticalInformationChangeRequest[]
  decidedHotelApplications                 HotelApplication[]
  registeredHotels                         Hotel[]
  passwordResetRequests                    PasswordResetRequest[]
  sessions                                 Session[]
  verificationRequests                     VerificationRequest[]
  customerProfile                          CustomerProfile?
  createdAvailabilityBlocks                HallAvailabilityBlock[]
  customerBookings                         Booking[]                          @relation("CustomerBookings")
  verifiedBookingPayments                  Booking[]                          @relation("VerifiedBookingPayments")
  cancelledBookings                        Booking[]                          @relation("CancelledBookings")
  savedHotels                              SavedHotel[]
  reviews                                  Review[]
  notifications                            Notification[]
  deviceTokens                             DeviceToken[]

  @@map("users")
}

/// Customer-owned business profile, deliberately separate from Authentication.
/// Profile fields remain empty/flexible until the pending M02 business decisions
/// approve an explicit allowlist and completion policy.
model CustomerProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  profileData Json      @default("{}") @map("profile_data")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

/// One authenticated session (Technical Design §5, §9). Session and Refresh
/// Token are modeled as a single 1:1 table, per database-standards.md §10
/// ("One-to-One... used only when splitting a table for a genuine lifecycle
/// or access-control reason — never just to organize columns for tidiness").
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// Never the raw refresh token — hashed at rest, same as a password
  /// (data-architecture.md §13, Restricted classification).
  refreshTokenHash String    @unique @map("refresh_token_hash")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user_id")
  @@map("sessions")
}

/// A pending or resolved mobile-number verification attempt (BR-AUTH-02,
/// Technical Design §13.3). Scaffolded now (Technical Design §5); the
/// Verification Component's endpoints (WBS-10) are a later increment.
model VerificationRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at")
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_verification_requests_user_id")
  @@map("verification_requests")
}

/// A pending or resolved password-reset attempt (BR-AUTH-09). Scaffolded now
/// (Technical Design §5); the Password Reset endpoints (WBS-11b) are a later
/// increment.
model PasswordResetRequest {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Never the raw reset token — hashed at rest (data-architecture.md §13).
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_requests_user_id")
  @@map("password_reset_requests")
}

/// The Hotel business entity and tenant (Technical Design §4) — the
/// aggregate root every other component in this module operates on. Never
/// holds Hotel Manager identity/credentials (Module 1's User, §3.2).
model Hotel {
  id                     String                             @id @default(uuid()) @db.Uuid
  /// The Hotel Manager who registered this Hotel (HM1). Technical Design
  /// §4.1 notes a Hotel may be referenced by more than one Hotel Manager
  /// account per Project-Glossary.md ("at least one"), but no approved
  /// journey exercises more than one — a single registering-owner reference
  /// is the simplest design that satisfies every approved journey
  /// (architecture-principles.md §2, Simplicity before complexity). A
  /// many-to-many assignment table is a additive change if ever required.
  registeredByUserId     String                             @map("registered_by_user_id") @db.Uuid
  /// The Hotel Lifecycle (Technical Design §6.1) — the single source of
  /// truth for what a Hotel may currently do. Mutated only through the
  /// Lifecycle (State) Component (lifecycle.service.js), never directly.
  status                 HotelStatus                        @default(REGISTERED)
  /// Profile content is deliberately unspecified — Business Specification
  /// Pending Business Decision #7 (Required Business-Profile Content).
  /// Held as a flexible field until that decision resolves; Technical
  /// Design §4 explicitly avoids inventing named profile columns ahead of
  /// an approved decision.
  profileData            Json?                              @map("profile_data")
  createdAt              DateTime                           @default(now()) @map("created_at")
  updatedAt              DateTime                           @updatedAt @map("updated_at")
  deletedAt              DateTime?                          @map("deleted_at")
  criticalChangeRequests CriticalInformationChangeRequest[]
  halls                  Hall[]
  applications           HotelApplication[]
  media                  HotelMedia[]
  bookings               Booking[]
  registeredBy           User                               @relation(fields: [registeredByUserId], references: [id])
  savedBy                SavedHotel[]
  reviews                Review[]
  notifications          Notification[]

  @@index([status], map: "idx_hotels_status")
  @@map("hotels")
}

/// A Customer's saved/bookmarked Hotel — a personal, non-business-rule
/// bookmark (never a live eligibility/availability check): a Hotel stays
/// saved even if it later becomes ineligible for ordinary browsing, the
/// same way Booking History still shows past Bookings regardless of the
/// Hotel's current status.
model SavedHotel {
  id             String   @id @default(uuid()) @db.Uuid
  customerUserId String   @map("customer_user_id") @db.Uuid
  hotelId        String   @map("hotel_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  customer User  @relation(fields: [customerUserId], references: [id])
  hotel    Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([customerUserId, hotelId])
  @@index([customerUserId, createdAt], map: "idx_saved_hotels_customer_created_at")
  @@map("saved_hotels")
}

/// A Customer's review of a Hotel (Ratings & Reviews V1, approved business
/// decisions) — always tied to one COMPLETED Booking (`bookingId` unique,
/// enforcing "one review per completed Booking" at the database level, not
/// just in application code). Never shows the reviewing Customer's identity
/// publicly — this platform has no existing convention for exposing a
/// Customer's identity to anyone but themselves or the Hotel Manager who
/// owns their Booking (mobileNumber is private, BR-AUTH-02).
model Review {
  id             String   @id @default(uuid()) @db.Uuid
  bookingId      String   @unique @map("booking_id") @db.Uuid
  customerUserId String   @map("customer_user_id") @db.Uuid
  hotelId        String   @map("hotel_id") @db.Uuid
  rating         Int
  text           String?
  createdAt      DateTime @default(now()) @map("created_at")

  booking  Booking @relation(fields: [bookingId], references: [id])
  customer User    @relation(fields: [customerUserId], references: [id])
  hotel    Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, createdAt], map: "idx_reviews_hotel_created_at")
  @@map("reviews")
}

/// A single uploaded Hotel Logo or Photo (BDR-015, ADR-0006, Technical
/// Design §4, §8a). Stores only a reference to the file in Supabase
/// Storage — never the binary itself (database-standards.md). At most one
/// LOGO record per Hotel at a time is a business-level constraint enforced
/// by the Media Component, not a database constraint (Technical Design §5)
/// — PHOTO has no such limit.
model HotelMedia {
  id           String    @id @default(uuid()) @db.Uuid
  hotelId      String    @map("hotel_id") @db.Uuid
  type         MediaType
  /// The Supabase Storage object path (bucket-relative) — e.g.
  /// `hotels/{hotelId}/logo/{fileId}.jpg` — the permanent database
  /// reference. Never a temporary signed URL (Technical Design §8a); a
  /// stable public URL is derived from this path at read time.
  storagePath  String    @map("storage_path")
  displayOrder Int?      @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  hotel        Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId], map: "idx_hotel_media_hotel_id")
  @@map("hotel_media")
}

/// One review cycle (Technical Design §4) — the initial submission, or a
/// new record for each resubmission after rejection (BR-HOTEL-07).
/// Historical, append-only: never overwritten, never reopened once decided
/// (Technical Design §5, §15.2).
model HotelApplication {
  id              String                 @id @default(uuid()) @db.Uuid
  hotelId         String                 @map("hotel_id") @db.Uuid
  status          HotelApplicationStatus @default(OPEN)
  /// The Platform Administrator who approved/rejected this Application
  /// (Administration & Platform Management, Module 13 — referenced, never
  /// owned, BR-HOTEL-14).
  decidedByUserId String?                @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?              @map("decided_at")
  decisionReason  String?                @map("decision_reason")
  submittedAt     DateTime               @default(now()) @map("submitted_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  decidedBy       User?                  @relation(fields: [decidedByUserId], references: [id])
  hotel           Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  notifications   Notification[]

  @@index([hotelId], map: "idx_hotel_applications_hotel_id")
  @@map("hotel_applications")
}

/// A critical-information change awaiting Platform Administrator review
/// (BR-HOTEL-12), independent of the Hotel's own status throughout its
/// lifecycle (Technical Design §6, §15.3 — the deliberate design response
/// to Pending Business Decision #6).
model CriticalInformationChangeRequest {
  id              String               @id @default(uuid()) @db.Uuid
  hotelId         String               @map("hotel_id") @db.Uuid
  status          CriticalChangeStatus @default(PENDING)
  /// The proposed change, shape TBD alongside Hotel.profileData (Pending
  /// Business Decision #7).
  proposedData    Json                 @map("proposed_data")
  decidedByUserId String?              @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?            @map("decided_at")
  submittedAt     DateTime             @default(now()) @map("submitted_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  decidedBy       User?                @relation(fields: [decidedByUserId], references: [id])
  hotel           Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId], map: "idx_critical_information_change_requests_hotel_id")
  @@map("critical_information_change_requests")
}

/// The Hall business entity — the Platform's bookable inventory (Technical
/// Design §4). Deliberately has no status/visibility column: a Hall's
/// visibility is computed live from its owning Hotel's operational-
/// eligibility status (Technical Design §6), never persisted or
/// synchronized here, so there is nothing to keep in sync or invalidate.
model Hall {
  id                     String                  @id @default(uuid()) @db.Uuid
  hotelId                String                  @map("hotel_id") @db.Uuid
  /// Profile content (including Amenities, BR-HALL-06) is deliberately
  /// unspecified — Business Specification Pending Business Decision #2
  /// (Required Hall Information). Held as a flexible field until that
  /// decision resolves, mirroring Hotel's own profileData design exactly
  /// (Technical Design §4, §8).
  profileData            Json?                   @map("profile_data")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  deletedAt              DateTime?               @map("deleted_at")
  hotel                  Hotel                   @relation(fields: [hotelId], references: [id])
  media                  HallMedia[]
  availabilityBlocks     HallAvailabilityBlock[]
  bookings               Booking[]
  rentAmountCents        Int?                    @map("rent_amount_cents")
  rentDurationHours      Int?                    @default(24) @map("rent_duration_hours")
  advancePaymentPercent  Decimal?                @map("advance_payment_percent") @db.Decimal(5, 2)
  customerServiceNumber  String?                 @map("customer_service_number")
  paymentReceivingNumber String?                 @map("payment_receiving_number")

  @@index([hotelId], map: "idx_halls_hotel_id")
  @@map("halls")
}

model Booking {
  id                     String        @id @default(uuid()) @db.Uuid
  customerUserId         String        @map("customer_user_id") @db.Uuid
  hotelId                String        @map("hotel_id") @db.Uuid
  hallId                 String        @map("hall_id") @db.Uuid
  startsAt               DateTime      @map("starts_at")
  endsAt                 DateTime      @map("ends_at")
  numberOfGuests         Int           @map("number_of_guests")
  eventType              EventType     @map("event_type")
  specialRequest         String?       @map("special_request")
  status                 BookingStatus @default(PENDING)
  paymentStatus          PaymentStatus @default(UNPAID) @map("payment_status")
  paymentDeadlineAt      DateTime      @map("payment_deadline_at")
  totalRentCents         Int           @map("total_rent_cents")
  advancePercentSnapshot Decimal       @map("advance_percent_snapshot") @db.Decimal(5, 2)
  requiredAdvanceCents   Int           @map("required_advance_cents")
  reportedAmountCents    Int?          @map("reported_amount_cents")
  paymentReportedAt      DateTime?     @map("payment_reported_at")
  paymentVerifiedAt      DateTime?     @map("payment_verified_at")
  paymentVerifiedById    String?       @map("payment_verified_by_id") @db.Uuid
  paymentRejectionReason String?       @map("payment_rejection_reason")
  cancelledAt            DateTime?     @map("cancelled_at")
  cancelledByUserId      String?       @map("cancelled_by_user_id") @db.Uuid
  completedAt            DateTime?     @map("completed_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  customer          User    @relation("CustomerBookings", fields: [customerUserId], references: [id])
  hotel             Hotel   @relation(fields: [hotelId], references: [id])
  hall              Hall    @relation(fields: [hallId], references: [id])
  paymentVerifiedBy User?   @relation("VerifiedBookingPayments", fields: [paymentVerifiedById], references: [id])
  cancelledBy       User?   @relation("CancelledBookings", fields: [cancelledByUserId], references: [id])
  review            Review?
  notifications     Notification[]

  @@index([customerUserId, createdAt], map: "idx_bookings_customer_created_at")
  @@index([hotelId, status, createdAt], map: "idx_bookings_hotel_status_created_at")
  @@index([hallId, startsAt, endsAt], map: "idx_bookings_hall_period")
  @@index([status, paymentDeadlineAt], map: "idx_bookings_status_payment_deadline")
  @@index([paymentStatus], map: "idx_bookings_payment_status")
  @@map("bookings")
}

/// A single uploaded Hall Photo (BDR-016, ADR-0007). Stores only a
/// bucket-relative Supabase Storage reference, never the binary itself.
/// Hall media supports Photos only; no Hall Logo business field exists.
model HallMedia {
  id           String    @id @default(uuid()) @db.Uuid
  hallId       String    @map("hall_id") @db.Uuid
  type         MediaType
  storagePath  String    @map("storage_path")
  displayOrder Int?      @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  hall         Hall      @relation(fields: [hallId], references: [id], onDelete: Cascade)

  @@index([hallId], map: "idx_hall_media_hall_id")
  @@map("hall_media")
}

/// A Hotel Manager-created period during which a Hall is deliberately not
/// bookable (maintenance, private event, cleaning, temporary closure, or
/// another legitimate reason) — Availability's own concept, independent of
/// and never overriding a Booking. Overlap protection for this table is
/// enforced by a hand-added PostgreSQL EXCLUDE constraint (see the
/// `availability_foundation` migration), not by Prisma/application code
/// alone.
model HallAvailabilityBlock {
  id              String   @id @default(uuid()) @db.Uuid
  hallId          String   @map("hall_id") @db.Uuid
  /// Absolute instant — the block covers [startsAt, endsAt).
  startsAt        DateTime @map("starts_at")
  /// Absolute instant, exclusive end.
  endsAt          DateTime @map("ends_at")
  /// Free-text Manager note (e.g. "Maintenance"). Never shown to Customers.
  reason          String?
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  hall      Hall @relation(fields: [hallId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdByUserId], references: [id])

  @@index([hallId, startsAt], map: "idx_hall_availability_blocks_hall_starts_at")
  @@map("hall_availability_blocks")
}

enum UserAccountType {
  CUSTOMER
  HOTEL_MANAGER
  STAFF
  PLATFORM_ADMINISTRATOR

  @@map("user_account_type")
}

enum HotelStatus {
  REGISTERED
  PROFILE_COMPLETE
  UNDER_REVIEW
  APPROVED_ACTIVE
  REJECTED
  WITHDRAWN
  SUSPENDED
  DEACTIVATED
  RESTRICTED_UNDER_REVIEW

  @@map("hotel_status")
}

enum MediaType {
  LOGO
  PHOTO

  @@map("media_type")
}

enum HotelApplicationStatus {
  OPEN
  APPROVED
  REJECTED
  WITHDRAWN

  @@map("hotel_application_status")
}

enum EventType {
  WEDDING
  CONFERENCE
  BIRTHDAY
  MEETING
  GRADUATION
  OTHER

  @@map("event_type")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
  EXPIRED

  @@map("booking_status")
}

enum PaymentStatus {
  UNPAID
  CUSTOMER_REPORTED
  PAID
  REJECTED

  @@map("payment_status")
}

enum CriticalChangeStatus {
  PENDING
  APPLIED
  REJECTED

  @@map("critical_change_status")
}

/// A persisted, user-facing Notification (Notification V1, Module 10 —
/// Business Specification "Business Rules" #2/#13). Distinct from the
/// structured-log audit events `bookings/audit.js`/`hotels/audit.js` already
/// record — this is an owned entity with its own read/unread lifecycle, not
/// a resurrection of the project-wide "no approved Audit Record entity" gap.
/// `bookingId`/`hotelId`/`hotelApplicationId` are independent and nullable —
/// present only so the client can compute a navigation target; the backend
/// never re-derives a business rule from them.
model Notification {
  id                 String             @id @default(uuid()) @db.Uuid
  recipientUserId    String             @map("recipient_user_id") @db.Uuid
  type               NotificationType
  status             NotificationStatus @default(UNREAD)
  title              String
  body               String
  bookingId          String?            @map("booking_id") @db.Uuid
  hotelId            String?            @map("hotel_id") @db.Uuid
  hotelApplicationId String?            @map("hotel_application_id") @db.Uuid
  readAt             DateTime?          @map("read_at")
  createdAt          DateTime           @default(now()) @map("created_at")

  recipient        User              @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  booking          Booking?          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotel            Hotel?            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelApplication HotelApplication? @relation(fields: [hotelApplicationId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt], map: "idx_notifications_recipient_created_at")
  @@index([recipientUserId, status], map: "idx_notifications_recipient_status")
  @@map("notifications")
}

enum NotificationType {
  BOOKING_REQUEST_SUBMITTED
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  PAYMENT_REPORTED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  BOOKING_EXPIRED
  NEW_BOOKING_REQUEST
  CUSTOMER_PAYMENT_REPORTED
  CUSTOMER_BOOKING_CANCELLED
  NEW_HOTEL_APPLICATION
  HOTEL_APPLICATION_WITHDRAWN
  HOTEL_APPLICATION_RESUBMITTED

  @@map("notification_type")
}

enum NotificationStatus {
  UNREAD
  READ

  @@map("notification_status")
}

/// One registered push-delivery target (Firebase Cloud Messaging, ADR-0001)
/// per physical device/app-install. `token` is globally unique, not unique
/// per user — re-registering the same device under a different account
/// (a shared device, or logout/login as someone else) moves it to the new
/// owner via upsert-by-token rather than duplicating it under both.
model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_device_tokens_user_id")
  @@map("device_tokens")
}
