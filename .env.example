# ==========================================================================
# Environment template — Hotel Hall Booking Management System
# ==========================================================================
# Copy to `.env` and fill in real values locally. Never commit `.env`.
# Naming follows docs/03-standards/naming-conventions.md §10 (UPPER_SNAKE_CASE).
# Placeholders only — no real values belong in this file.
# ==========================================================================

# --- Application -----------------------------------------------------------
NODE_ENV=
PORT=

# --- Database (PostgreSQL via Prisma) --------------------------------------
DATABASE_URL=

# --- Database (Docker Compose PostgreSQL service only — docker-compose.yml) -
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Authentication (JWT + Refresh Tokens) ----------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# Development defaults if unset (15 / 7) — Session Validity Duration is
# Business Specification Pending Business Decision #3, not yet settled;
# see docs/05-technical-design/modules/01-authentication-and-account-management/technical-design.md §9.
ACCESS_TOKEN_TTL_MINUTES=
REFRESH_TOKEN_TTL_DAYS=

# Argon2id parameters — OWASP baseline defaults if unset (19456 / 2 / 1).
# See technical-design.md §11.
ARGON2_MEMORY_COST_KIB=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=

# --- Storage (Cloudinary — default provider behind the storage abstraction,
#     docs/02-architecture/technology-stack.md) -----------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Notifications (Firebase Cloud Messaging) -------------------------------
FCM_SERVER_KEY=

# --- SMS delivery (Twilio, ADR-0005) — scoped to Authentication & Account
#     Management's identity-verification and password-reset flows. Not yet
#     consumed by code (WBS-10/WBS-11b are a later increment). -------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
